# Supabase Configuration
# Get these values from your Supabase project dashboard (Project Settings > API)

# Your Supabase project URL (e.g., https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here

# Your Supabase anon/public key (long string starting with eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Copy this file to `.env.local` in the same directory
# 2. Replace the values above with your actual Supabase credentials
# 3. Restart your development server (npm run dev)
#
# If you don't have Supabase set up yet, the app will work in localStorage mode
# Follow SUPABASE_SETUP.md for complete setup instructions
# ============================================================================
